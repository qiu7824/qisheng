#pragma code_page(65001)
// Windows resources for the 栖声 desktop player.
// Icon id 1 is the file icon in Explorer; ZSUI also loads it for the
// window (taskbar, Alt+Tab) and the notification-area icon.
#include <winver.h>

1 ICON "lx-native.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,19
 PRODUCTVERSION 0,3,0,19
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "栖声"
      VALUE "FileDescription", "栖声 音乐播放器"
      VALUE "FileVersion", "0.3.0-alpha.19"
      VALUE "InternalName", "qisheng"
      VALUE "OriginalFilename", "栖声.exe"
      VALUE "ProductName", "栖声"
      VALUE "ProductVersion", "0.3.0-alpha.19"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
